@require './config';
@require './nprogress';
@require './code';
@require './custom-blocks';
@require './arrow';
@require './wrapper';
@require './toc';

html, body {
  padding: 0;
  margin: 0;
}

body {
  font-family: $fontSans;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 16px;
  line-height: 1.65;
  color: $textColor;
}

.page {
  padding-top: $navbarHeight;
  padding-left: $sidebarWidth;
}

.navbar {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  right: 0;
  height: $navbarHeight;
  background-color: $navbarBackgroundColor;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), 0 8px 24px rgba(1, 0, 41, 0.16);
  box-sizing: border-box;
}

.sidebar-mask {
  position: fixed;
  z-index: 9;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: none;
  background: rgba(15, 23, 42, 0.35);
}

.sidebar {
  font-size: 14.5px;
  background-color: $sidebarColor;
  width: $sidebarWidth;
  position: fixed;
  z-index: 10;
  margin: 0;
  top: $navbarHeight;
  left: 0;
  bottom: 0;
  box-sizing: border-box;
  border-right: 1px solid $borderColor;
  overflow-y: auto;
}

.content__default:not(.custom) {
  @extend $wrapper;

  > *:first-child {
    margin-top: $navbarHeight;
  }

  a:hover {
    text-decoration: underline;
  }

  p.demo {
    padding: 1rem 1.5rem;
    border: 1px solid $borderColor;
    border-radius: $radius;
  }

  img {
    max-width: 100%;
    border-radius: $radiusSm;
  }
}

.content__default.custom {
  padding: 0;
  margin: 0;

  img {
    max-width: 100%;
  }
}

a {
  font-weight: 500;
  color: $accentColor;
  text-decoration: none;
  transition: color .12s ease;
}

p a code {
  font-weight: 400;
  color: $accentColor;
}

kbd {
  background: $blockColor;
  border: solid 0.1rem $borderColor;
  border-bottom-width: 0.2rem;
  border-radius: $radiusSm - 2px;
  padding: 0.05em 0.4em;
  font-family: $fontMono;
  font-size: 0.85em;
}

blockquote {
  font-size: 1.05rem;
  color: $mutedTextColor;
  border-left: 0.25rem solid $borderColor;
  margin-left: 0;
  padding: 0.25rem 0 0.25rem 1.1rem;
}

ul, ol {
  padding-left: 1.3em;
}

strong {
  font-weight: 600;
}

h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
  scroll-margin-top: $navbarHeight + 1rem;

  .content__default:not(.custom) > & {
    margin-top: 0.5rem - $navbarHeight;
    padding-top: ($navbarHeight + 1rem);
    margin-bottom: 0;

    &:first-child {
      margin-top: -5rem;
      margin-bottom: 1rem;

      + p, + pre, + .custom-block {
        margin-top: 2rem;
      }
    }
  }

  &:hover .header-anchor {
    opacity: 1;
  }
}

h1 {
  font-size: 2.35rem;
  letter-spacing: -0.02em;
}

h2 {
  font-size: 1.6rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid $borderColor;
}

h3 {
  font-size: 1.25rem;
}

h4 {
  font-size: 1.05rem;
}

a.header-anchor {
  font-size: 0.85em;
  float: left;
  margin-left: -0.87em;
  padding-right: 0.23em;
  margin-top: 0.125em;
  opacity: 0;
  color: $mutedTextColor;

  &:hover {
    text-decoration: none;
    color: $accentColor;
  }
}

code, kbd, .line-number {
  font-family: $fontMono;
}

p, ul, ol {
  line-height: 1.75;
}

hr {
  border: 0;
  border-top: 1px solid $borderColor;
  margin: 2rem 0;
}

table {
  border-collapse: separate;
  border-spacing: 0;
  margin: 1.25rem 0;
  display: block;
  overflow-x: auto;
  border: 1px solid $borderColor;
  border-radius: $radius;
}

tr {
  border-top: 1px solid $borderColor;

  &:first-child {
    border-top: none;
  }

  &:nth-child(2n) {
    background-color: $blockColor;
  }
}

th, td {
  border-left: 1px solid $borderColor;
  padding: 0.65em 1.1em;
  font-size: 0.92em;

  &:first-child {
    border-left: none;
  }
}

th {
  background-color: $blockColor;
  font-weight: 600;
  text-align: left;
}

.custom-layout {
  padding-top: $navbarHeight;
}

.theme-container {
  &.sidebar-open {
    .sidebar-mask {
      display: block;
    }
  }

  &.no-navbar {
    .content__default:not(.custom) > h1, h2, h3, h4, h5, h6 {
      margin-top: 1.5rem;
      padding-top: 0;
    }

    .sidebar {
      top: 0;
    }

    .custom-layout {
      padding-top: 0;
    }
  }
}

@media (min-width: ($MQMobile + 1px)) {
  .theme-container.no-sidebar {
    .sidebar {
      display: none;
    }

    .page {
      padding-left: 0;
    }
  }
}

@require './mobile.styl';
@require './override.styl';
