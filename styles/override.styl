// Converts a color to rgba(), extracting white values
// hat tip https://stackoverflow.com/a/6672545/1688568
toRgba(color) {
  r = red(color);
  g = green(color);
  b = blue(color);
  min = min(r, g, b);
  a = ((255 - min) / 255);
  rA = ((r - min) / a);
  gA = ((g - min) / a);
  bA = ((b - min) / a);
  'rgba(%s, %s, %s, %s)' % (rA gA bA a);
}

.sidebar {
  background: $sidebarColor;
}

.content__default {
  dl {
    display: flex;
    flex-flow: row wrap;
    padding: 1.25rem 1.5rem;
    line-height: 1.7;
    background: $blockColor;
    border-radius: $radius;

    dt, dd {
      margin: 0.25rem 0 0;
      word-wrap: break-word;
    }

    dt {
      width: 9rem;
      padding-right: 1rem;
      box-sizing: border-box;
      display: flex;
      align-items: top;
      justify-content: flex-end;
      font-weight: bold;
    }

    dd {
      width: calc(100% - 9rem);
    }
  }

  tr:nth-child(2n) {
    background-color: $blockColor;
  }

  pre, pre[class*='language-'] {
    white-space: pre;
  }

  .highlighted-line {
    background-color: rgba(15, 23, 42, 0.06);
  }

  .code-toggle {
    margin: 1.1rem 0;

    ul.code-language-switcher {
      border-radius: $radius $radius 0 0;
    }

    div[class*='language-'] {
      border-radius: 0 0 $radius $radius;
      box-shadow: none;

      &:before {
        display: none;
      }
    }

    & > div > div[class*='language-'] {
      & > pre, & > pre[class*='language-'] {
        margin: 0;
      }
    }
  }

  a.outbound-link {
    color: $mutedTextColor;
    margin-right: 0.25rem;
  }

  a + svg.outbound {
    margin-left: 0.25rem;
    position: relative;
    top: 2px;
  }

  .custom-block {
    div[class*='language-'] {
      background: $codeTabBgColor;
      border-radius: 0;
      margin-left: -24px;
      margin-right: -24px;
      box-shadow: none;

      .highlight-lines {
        padding-top: 0;
      }

      pre, pre[class*='language-'] {
        padding-top: 0;
        padding-bottom: 0;
      }
    }
  }
}

ul.code-language-switcher {
  height: $navbarHeight;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0;
  padding: 0.7rem 1.5rem;
  font-size: 14px;
  line-height: 1.4;
  z-index: 2;
  background: $codeTabBgColor;
  gap: 0.35rem;

  li {
    margin: 0;
    padding: 0;
    list-style-type: none;

    a {
      display: block;
      padding: 0 0.85rem;
      line-height: 2.2rem;
      cursor: pointer;
      border-radius: $radiusSm;
      font-weight: 500;
      color: $codeMutedColor;
      transition: background-color .12s ease, color .12s ease;

      &:hover {
        text-decoration: none !important;

        &:not(.active) {
          background: rgba(15, 23, 42, 0.05);
          color: $textColor;
        }
      }

      &.active {
        cursor: default;
        background-color: $codeBgColor;
        color: $textColor;
      }
    }
  }
}

.theme-container.split {
  .page {
    & > ul.code-language-switcher {
      position: fixed;
      top: $navbarHeight;
      padding: 0.7rem 1.5rem;
    }
  }
}

@media (min-width: $MQNarrow + 1) {
  // Text (left) / code (right) split ratio for the API-reference "split"
  // layout — was an even 50/50; narrowed the code column to give the
  // documentation text more room.
  $splitTextFrac = 0.58
  $splitCodeFrac = 0.42

  .theme-container.split {
    .page {
      position: relative;
      width: 'calc(58% - %s)' % ($sidebarWidth * $splitTextFrac);

      &:after {
        display: block;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 'calc(42% - %s)' % ($sidebarWidth * $splitCodeFrac);
        background: $codeBgColor;
        content: '.';
        font-size: 0;
        box-sizing: border-box;
      }

      & > ul.code-language-switcher {
        right: 0;
        width: 'calc(42% - %s)' % ($sidebarWidth * $splitCodeFrac);
      }

      .content__default {
        margin-right: 0;

        .split {
          margin: 0 -1.5rem;
          width: calc(172.41% + 6rem);
          display: flex;
          flex-direction: row;
          box-sizing: border-box;

          & > div {
            z-index: 1;
            width: 58%;
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            box-sizing: border-box;

            &.right {
              width: 42%;
              color: $textColor;

              pre, pre[class*='language-'] {
                margin-left: -1.5rem;
                margin-right: -1.5rem;
                padding: 0 1.5rem;
                white-space: pre-wrap;
                background-color: transparent;

                &:before {
                  display: none;
                  box-sizing: border-box;
                }

                .highlighted-line {
                  margin: 0 -1.5rem;
                  padding: 0 1.5rem;
                }
              }
            }
          }
        }
      }
    }
  }
}

// narrow desktop / iPad
@media (max-width: $MQNarrow) {
  .theme-container.split {
    .page {
      & > ul.code-language-switcher {
        padding-left: 2rem;
        padding-right: 2rem;
        width: 'calc(100% - %s)' % ($sidebarWidth * 0.82);
      }

      .content__default {
        & > *:first-child {
          margin-top: $navbarHeight * 2;
        }

        & > h1, & > h2, & > h3, & > h4, & > h5, & > h6 {
          &:first-child {
            padding-top: 0;
          }
        }
      }

      pre, pre[class*='language-'] {
        margin: 1em 0;
        border-radius: $radius;
      }

      h1, h2, h3, h4, h5, h6 {
        margin-top: 0.5rem - $navbarHeight - $navbarHeight;
        padding-top: ($navbarHeight + $navbarHeight + 1rem);
      }
    }
  }

  // same narrow-split doubled clearance as above, plus the product-tabs strip
  .theme-container.has-product-nav.split {
    .page {
      .content__default > *:first-child {
        margin-top: ($navbarHeight * 2 + $productNavHeight);
      }

      h1, h2, h3, h4, h5, h6 {
        margin-top: (0.5rem - $navbarHeight - $navbarHeight - $productNavHeight);
        padding-top: ($navbarHeight + $navbarHeight + $productNavHeight + 1rem);
      }
    }
  }
}

// wide mobile
@media (max-width: $MQMobile) {
  .theme-container.split {
    .page {
      & > ul.code-language-switcher {
        width: 100%;
      }
    }
  }
}

// narrow mobile
@media (max-width: $MQMobileNarrow) {
  .theme-container.split {
    .page {
      & > ul.code-language-switcher {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }
    }
  }
}

// Layout offsets for pages showing the persistent product-switcher tab strip
// (components/ProductTabs.vue, fixed under the navbar on /api-reference/*
// pages). The strip adds $productNavHeight of fixed-position chrome above
// the content, so every navbarHeight-based "clear the fixed header" hack
// used elsewhere (scroll-margin-top, the first-heading offset trick, the
// split layout's pinned code-language switcher) needs that height added
// back in — but only on pages that actually show the strip. Scoped under
// .theme-container.has-product-nav so the rest of the site is untouched,
// and kept outside the $MQMobile off-canvas-sidebar breakpoint since that
// one manages its own top offset independently.
.theme-container.has-product-nav {
  .page {
    padding-top: ($navbarHeight + $productNavHeight);
  }

  .content__default:not(.custom) {
    > *:first-child {
      margin-top: ($navbarHeight + $productNavHeight);
    }

    > h1, > h2, > h3, > h4, > h5, > h6 {
      margin-top: (0.5rem - $navbarHeight - $productNavHeight);
      padding-top: ($navbarHeight + $productNavHeight + 1rem);

      &:first-child {
        margin-top: -5rem;
      }
    }
  }

  h1, h2, h3, h4, h5, h6 {
    scroll-margin-top: ($navbarHeight + $productNavHeight + 1rem);
  }

  &.split .page > ul.code-language-switcher {
    top: ($navbarHeight + $productNavHeight);
  }
}

div.table {
  margin: 1.25rem 0;
  border: 1px solid $borderColor;
  border-radius: $radius;
  overflow: hidden;
  overflow-x: auto;

  table {
    display: table;
    margin: 0;
    border: none;
    border-radius: 0;
    width: 100%;

    thead, tbody:first-child {
      tr:first-child {
        &, th, td {
          border-top: none;
        }
      }
    }

    tbody tr:last-child {
      th, td {
        border-bottom: none;
      }
    }

    th, td {
      &:first-child {
        border-left: none;
      }

      &:last-child {
        border-right: none;
      }
    }
  }
}

div[class='language-php']:before {
  content: 'php';
}

div[class='language-twig']:before {
  content: 'twig';
}

.algolia-search-wrapper {
  .algolia-autocomplete {
    .ds-dropdown-menu {
      padding: 0.7rem;
    }

    .algolia-docsearch-suggestion {
      .algolia-docsearch-suggestion--category-header {
        padding: 5px 0;
        margin-bottom: 0.5rem;
      }

      .algolia-docsearch-suggestion--subcategory-column {
        background: none;
      }

      .algolia-docsearch-suggestion--category-header {
        color: inherit;
        background: none;
      }
    }

    .algolia-docsearch-suggestion--highlight {
      color: $accentColor;
    }
  }
}

.algolia-autocomplete {
  .algolia-docsearch-suggestion--text {
    .algolia-docsearch-suggestion--highlight {
      box-shadow: none;
    }
  }
}
