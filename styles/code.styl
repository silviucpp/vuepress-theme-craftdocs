@require './config'

.content__default
  code
    color #b5473b
    padding 0.2rem 0.45rem
    margin 0
    font-size 0.85em
    background-color rgba(27, 31, 35, 0.06)
    border-radius $radiusSm - 1px

.content__default
  pre, pre[class*="language-"]
    line-height 1.6
    padding 1.25rem 1.5rem
    margin 1.1rem 0
    background-color $codeBgColor
    border-radius $radius
    overflow auto
    code
      color inherit
      padding 0
      background-color transparent
      border-radius 0

div[class*="language-"]
  position relative
  background-color $codeBgColor
  border-radius $radius
  box-shadow $shadowSm
  color $textColor

  // Prism's own theme (prism-tomorrow.css) sets `color: #ccc` directly on
  // pre[class*="language-"] / code[class*="language-"] at a specificity our
  // earlier `color $textColor` above (on the outer div) doesn't beat, so any
  // untokenized code text was still falling back to that light gray. Match
  // its selector at higher specificity to win outright.
  pre[class*="language-"], code[class*="language-"]
    color $textColor

  .highlight-lines
    user-select none
    padding-top 1.3rem
    position absolute
    top 0
    left 0
    width 100%
    line-height 1.6
    .highlighted
      background-color rgba(15, 23, 42, 0.06)

  pre, pre[class*="language-"]
    background transparent
    position relative
    z-index 1

  &::before
    position absolute
    z-index 3
    top 0.75em
    right 1.1em
    font-size 0.7rem
    font-weight 600
    letter-spacing 0.04em
    text-transform uppercase
    color $codeMutedColor
    pointer-events none

  &:not(.line-numbers-mode)
    .line-numbers-wrapper
      display none

  &.line-numbers-mode
    .highlight-lines .highlighted
        position relative
        &:before
          content ' '
          position absolute
          z-index 3
          left 0
          top 0
          display block
          width $lineNumbersWrapperWidth
          height 100%
          background-color rgba(15, 23, 42, 0.05)
    pre
      padding-left $lineNumbersWrapperWidth + 1 rem
      vertical-align middle
    .line-numbers-wrapper
      position absolute
      top 0
      width $lineNumbersWrapperWidth
      text-align center
      color rgba(28, 35, 51, 0.35)
      padding 1.25rem 0
      line-height 1.6
      br
        user-select none
      .line-number
        position relative
        z-index 4
        user-select none
        font-size 0.85em
    &::after
      content ''
      position absolute
      z-index 2
      top 0
      left 0
      width $lineNumbersWrapperWidth
      height 100%
      border-radius $radius 0 0 $radius
      border-right 1px solid rgba(15, 23, 42, 0.1)
      background-color $codeBgColor

  // copy-to-clipboard affordance, injected by enhanceApp.js
  .code-copy
    position absolute
    z-index 4
    bottom 0.65em
    right 0.9em
    font-family $fontSans
    font-size 0.72rem
    font-weight 600
    letter-spacing 0.02em
    color $textColor
    background rgba(15, 23, 42, 0.06)
    border 1px solid rgba(15, 23, 42, 0.12)
    border-radius $radiusSm
    padding 0.3rem 0.6rem
    cursor pointer
    opacity 0
    transform translateY(2px)
    transition opacity .15s ease, transform .15s ease, background-color .15s ease, border-color .15s ease, color .15s ease
    outline none

    &:hover
      background rgba(15, 23, 42, 0.1)

    &.copied
      color #fff
      background $accentColor
      border-color $accentColor

  &:hover .code-copy, .code-copy:focus-visible
    opacity 1
    transform translateY(0)

for lang in $codeLang
  div{'[class~="language-' + lang + '"]'}
    &:before
      content ('' + lang)

div[class~="language-javascript"]
  &:before
    content "js"

div[class~="language-typescript"]
  &:before
    content "ts"

div[class~="language-markup"]
  &:before
    content "html"

div[class~="language-markdown"]
  &:before
    content "md"

div[class~="language-json"]:before
  content "json"

div[class~="language-ruby"]:before
  content "rb"

div[class~="language-python"]:before
  content "py"

div[class~="language-bash"]:before
  content "sh"

// Prism ships with the stock "tomorrow" dark theme (pastel tokens tuned for
// a near-black background). Now that code blocks sit on a light surface,
// re-map its token colors to a readable light-theme palette. Scoped under
// div[class*="language-"] so these win over Prism's plain .token.* rules
// regardless of CSS source order.
div[class*="language-"]
  .token.comment, .token.block-comment, .token.prolog, .token.doctype, .token.cdata
    color #6e7781
  .token.punctuation
    color #383f4a
  .token.attr-name, .token.deleted, .token.namespace, .token.tag
    color #cf222e
  .token.function-name
    color #0550ae
  .token.boolean, .token.function, .token.number
    color #953800
  .token.class-name, .token.constant, .token.property, .token.symbol
    color #6639ba
  .token.atrule, .token.builtin, .token.important, .token.keyword, .token.selector
    color #8250df
  .token.attr-value, .token.char, .token.regex, .token.string, .token.variable
    color #116329
  .token.entity, .token.operator, .token.url
    color #0969da
  .token.inserted
    color #116329
